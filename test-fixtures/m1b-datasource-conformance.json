{
  "corpusVersion": "1.0.0",
  "description": "M1b-1 PR A 只读数据源声明与 executeDataSource 的合法/非法语料。独立于 M1a 定型语料（m1a-page-logic-conformance.json），不修改后者。结构合法不等于生产允许：本语料全部 schema 在生产可信清单下均以 CAPABILITY_UNSUPPORTED 拒绝（data-source 默认 unsupported）。",
  "schema": {
    "schemaVersion": 0,
    "rootId": "root",
    "components": {
      "root": {
        "id": "root",
        "type": "Page",
        "childrenIds": ["searchBtn"]
      },
      "searchBtn": {
        "id": "searchBtn",
        "type": "Button",
        "props": { "children": "查询" },
        "events": {
          "onClick": [
            {
              "type": "executeDataSource",
              "sourceId": "searchItems",
              "resultTo": "state.rows"
            }
          ]
        }
      }
    },
    "logic": {
      "states": { "query": "", "rows": [] },
      "dataSources": {
        "searchItems": {
          "operationRef": { "operationId": "demo.items.search", "revision": "1" },
          "params": { "query": "{{ state.query }}" }
        }
      }
    }
  },
  "flowSchema": {
    "schemaVersion": 0,
    "rootId": "root",
    "components": {
      "root": {
        "id": "root",
        "type": "Page",
        "childrenIds": ["searchBtn"]
      },
      "searchBtn": {
        "id": "searchBtn",
        "type": "Button",
        "props": { "children": "查询" },
        "events": {
          "onClick": [{ "type": "runFlow", "flow": "searchFlow" }]
        }
      }
    },
    "logic": {
      "states": { "query": "", "rows": [] },
      "dataSources": {
        "searchItems": {
          "operationRef": { "operationId": "demo.items.search", "revision": "1" },
          "params": { "query": "{{ state.query }}" }
        }
      },
      "flows": {
        "searchFlow": {
          "steps": [
            {
              "type": "if",
              "condition": true,
              "then": [
                {
                  "type": "executeDataSource",
                  "sourceId": "searchItems",
                  "resultTo": "state.rows"
                }
              ]
            },
            {
              "type": "loop",
              "over": [1, 2],
              "itemVar": "item",
              "actions": [
                {
                  "type": "executeDataSource",
                  "sourceId": "searchItems",
                  "resultTo": "state.rows"
                }
              ]
            }
          ],
          "onError": [{ "type": "log", "value": "search failed" }]
        }
      }
    }
  },
  "legacyApiCallSchema": {
    "schemaVersion": 0,
    "rootId": "root",
    "components": {
      "root": {
        "id": "root",
        "type": "Page",
        "events": {
          "onClick": [
            {
              "type": "apiCall",
              "url": "/api/items",
              "method": "GET",
              "resultTo": "data.items"
            }
          ]
        }
      }
    }
  },
  "negativeCases": [
    {
      "name": "floatingRevisionLatest",
      "mutation": "logic.dataSources.searchItems.operationRef.revision = 'latest'",
      "schema": {
        "schemaVersion": 0,
        "rootId": "root",
        "components": { "root": { "id": "root", "type": "Page" } },
        "logic": {
          "states": { "rows": [] },
          "dataSources": {
            "searchItems": {
              "operationRef": { "operationId": "demo.items.search", "revision": "latest" }
            }
          }
        }
      },
      "expectedCode": "OPERATION_REVISION_FLOATING",
      "expectedPath": ["logic", "dataSources", "searchItems", "operationRef", "revision"]
    },
    {
      "name": "floatingRevisionWildcard",
      "mutation": "revision = '*'",
      "schema": {
        "schemaVersion": 0,
        "rootId": "root",
        "components": { "root": { "id": "root", "type": "Page" } },
        "logic": {
          "states": { "rows": [] },
          "dataSources": {
            "searchItems": {
              "operationRef": { "operationId": "demo.items.search", "revision": "*" }
            }
          }
        }
      },
      "expectedCode": "OPERATION_REVISION_FLOATING",
      "expectedPath": ["logic", "dataSources", "searchItems", "operationRef", "revision"]
    },
    {
      "name": "revisionRangeMarker",
      "mutation": "revision = '~1'（范围记号不匹配精确修订模式）",
      "schema": {
        "schemaVersion": 0,
        "rootId": "root",
