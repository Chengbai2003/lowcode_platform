{
  "schema": {
    "schemaVersion": 0,
    "rootId": "root",
    "logic": {
      "states": {
        "price": 2,
        "quantity": 3,
        "freight": 4,
        "seen": 0
      },
      "computed": {
        "label": "String(computed.total)",
        "subtotal": "state.price * state.quantity",
        "total": "computed.subtotal + state.freight"
      }
    },
    "components": {
      "root": {
        "id": "root",
        "type": "Page",
        "childrenIds": ["computed-value", "seen-value", "change-price"]
      },
      "computed-value": {
        "id": "computed-value",
        "type": "Text",
        "props": {
          "children": "{{ computed.label }}"
        }
      },
      "seen-value": {
        "id": "seen-value",
        "type": "Text",
        "props": {
          "children": "{{ state.seen }}"
        }
      },
      "change-price": {
        "id": "change-price",
        "type": "Button",
        "props": {
          "children": "change price"
        },
        "events": {
          "onClick": [
            {
              "type": "setValue",
              "field": "state.price",
              "value": 5
            },
            {
              "type": "setValue",
              "field": "state.seen",
              "value": "{{ computed.total }}"
            }
          ]
        }
      }
    }
  },
  "expected": {
    "topology": ["subtotal", "total", "label"],
    "initial": {
      "state": {
        "price": 2,
        "quantity": 3,
        "freight": 4,
        "seen": 0
      },
      "computed": {
        "subtotal": 6,
        "total": 10,
        "label": "10"
      }
    },
    "afterChange": {
      "state": {
        "price": 5,
        "quantity": 3,
        "freight": 4,
        "seen": 19
      },
      "computed": {
        "subtotal": 15,
        "total": 19,
        "label": "19"
      }
    }
  },
  "edgeSchema": {
    "schemaVersion": 0,
    "rootId": "root",
    "logic": {
      "states": {
        "one": 1,
        "zero": 0,
        "items": [2],
        "optional": null,
        "profile": {
          "name": "Ada"
        }
      },
      "computed": {
        "arrayAdd": "state.items + state.one",
        "arraySubtract": "state.items - state.one",
        "arrayMultiply": "state.items * state.one",
        "arrayDivide": "state.items / state.one",
        "arrayModulo": "state.items % state.one",
        "arrayLess": "state.items < state.one",
        "arrayLessEqual": "state.items <= state.one",
        "arrayGreater": "state.items > state.one",
        "arrayGreaterEqual": "state.items >= state.one",
        "arrayLooseEqual": "state.items == 2",
        "arrayLooseUnequal": "state.items != 2",
        "arrayUnaryMinus": "-state.items",
        "arrayUnaryPlus": "+state.items",
        "callFallback": "Number(state.profile) || 5",
        "eagerLogical": "true || +state.profile",
        "invalid": "state.one / state.zero",
        "mathArray": "Math.max(state.items, state.one)",
        "mathFallback": "Math.abs(state.profile) || 7",
        "memberFallback": "state.optional.name || 'fallback'",
        "nullableView": "[state.optional.name]",
        "prototypeMemberFallback": "state.items.join || 'fallback'",
        "rounded": "Math.round(state.one + 0.4)",
        "view": "[state.profile]"
      }
    },
    "components": {
      "root": {
        "id": "root",
        "type": "Page"
      }
    }
  },
  "edgeExpected": {
    "undefinedKeys": [
      "arrayAdd",
      "arraySubtract",
      "arrayMultiply",
      "arrayDivide",
      "arrayModulo",
      "arrayLess",
      "arrayLessEqual",
      "arrayGreater",
      "arrayGreaterEqual",
      "arrayLooseEqual",
      "arrayLooseUnequal",
      "arrayUnaryMinus",
      "arrayUnaryPlus",
      "invalid",
      "mathArray"
    ],
    "values": {
      "callFallback": 5,
      "eagerLogical": true,
      "mathFallback": 7,
      "memberFallback": "fallback",
      "prototypeMemberFallback": "fallback",
      "rounded": 1
    },
    "arraysWithUndefinedItem": ["nullableView"],
    "view": [
      {
        "name": "Ada"
      }
    ]
  }
}
