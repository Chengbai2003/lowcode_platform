          "children": "change price"
        },
        "events": {
          "onClick": [
            {
              "type": "setValue",
              "field": "state.price",
              "value": 5
            },
            {
              "type": "setValue",
              "field": "state.seen",
              "value": "{{ computed.total }}"
            }
          ]
        }
      },
      "submit": {
        "id": "submit",
        "type": "Button",
        "props": {
          "children": "Submit"
