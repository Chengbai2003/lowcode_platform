              "input": {
                "source": "fixture"
              }
            }
          ]
        }
      },
      "status": {
        "id": "status",
        "type": "Text",
        "props": {
          "children": "{{state.source + ':' + state.count}}"
        }
      },
      "cancel-btn": {
        "id": "cancel-btn",
        "type": "Button",
        "props": {
          "children": "Cancel Delay"
