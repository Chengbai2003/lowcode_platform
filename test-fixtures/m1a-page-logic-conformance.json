      "delayed-value": {
        "id": "delayed-value",
        "type": "Text",
        "props": {
          "children": "{{state.delayedState}}"
        }
      }
    },
    "logic": {
      "states": {
        "price": 2,
        "quantity": 3,
        "freight": 4,
        "seen": 0,
        "count": 0,
        "source": "",
        "recovered": false,
        "delayedState": "initial"
      },
      "computed": {
        "label": "String(computed.total)",
        "subtotal": "state.price * state.quantity",
        "total": "computed.subtotal + state.freight"
      },
      "flows": {
        "recordSource": {
          "steps": [
            {
              "type": "setValue",
              "field": "state.source",
              "value": "{{input.source}}"
            }
          ]
        },
        "submitOrder": {
          "steps": [
            {
              "type": "runFlow",
              "flow": "recordSource",
              "input": {
                "source": "fixture"
              }
            },
            {
              "type": "setValue",
              "field": "state.count",
              "value": "{{state.count + 1}}"
            }
          ]
        },
        "recoverFailure": {
          "steps": [
            {
              "type": "apiCall",
              "url": "/fail"
            }
          ],
          "onError": [
            {
              "type": "setValue",
              "field": "state.recovered",
              "value": true
            }
          ]
        },
        "unhandledFailure": {
          "steps": [
            {
              "type": "apiCall",
              "url": "/fail"
            }
          ]
        },
        "cancelDelayFlow": {
          "steps": [
            {
              "type": "delay",
              "ms": 100
            },
            {
              "type": "setValue",
              "field": "state.delayedState",
              "value": "late_finish"
            }
          ]
        }
      }
    }
  },
