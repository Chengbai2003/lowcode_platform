{
  "corpusVersion": "1.0.0",
  "reviewReason": "Consolidated M1a-3 C1 Page Logic conformance baseline covering State, chained Computed, ActionFlow (success, nested call, onError recovery, unhandled failure), cancellation/no-write-back, legacy inline ActionList without logic, comprehensive edge computed operations, small limits budget exhaustion, and negative schema validation cases across Contract, Renderer, and Compiler surfaces.",
  "schema": {
    "schemaVersion": 0,
    "rootId": "root",
    "components": {
      "root": {
