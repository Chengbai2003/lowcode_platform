{
  "name": "@lowcode-platform/renderer",
  "version": "1.0.0",
  "description": "Environment-agnostic A2UI React renderer with Contract fail-close boundaries (Issue #19 / M0-4)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./host": {
      "types": "./dist/host/createRendererHost.d.ts",
      "import": "./dist/host/createRendererHost.js",
      "require": "./dist/host/createRendererHost.js",
      "default": "./dist/host/createRendererHost.js"
    },
    "./dsl": {
      "types": "./dist/dsl/index.d.ts",
      "import": "./dist/dsl/index.js",
      "require": "./dist/dsl/index.js",
      "default": "./dist/dsl/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@jsep-plugin/new": "^1.0.4",
    "@lowcode-platform/schema-contract": "workspace:*",
    "antd": "^5.0.0",
    "jsep": "^1.4.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^14.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@vitejs/plugin-react": "^4.2.1",
    "jsdom": "^23.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "rimraf": "^5.0.5",
    "typescript": "^5.0.0",
    "vite": "^5.0.8",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "private": true
}
