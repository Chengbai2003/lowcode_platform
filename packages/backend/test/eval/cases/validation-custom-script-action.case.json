{
  "id": "validation-custom-script-action",
  "category": "validation",
  "title": "非法输入：Schema 携带 customScript 动作",
  "intent": "回放一个包含 customScript 的模型输出",
  "capabilities": ["schema_validation", "security_validation"],
  "fixtures": {
    "schema": {
      "schemaVersion": 0,
      "rootId": "root",
      "components": {
        "root": {
          "id": "root",
          "type": "Page",
          "childrenIds": [],
          "events": {
            "onClick": [
              {
                "type": "customScript",
                "code": "alert(1)"
              }
            ]
          }
        }
      }
    }
  },
  "expected": {
    "schemaValid": false,
    "blocked": true,
    "blockedReason": "customScript"
  },
  "caseSchemaVersion": 1
}
