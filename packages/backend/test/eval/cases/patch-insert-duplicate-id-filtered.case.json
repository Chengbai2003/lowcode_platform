        },
        "title1": {
          "id": "title1",
          "type": "Title",
          "props": {
            "children": "Hello"
          }
        }
      }
    },
    "patch": [
      {
        "op": "insertComponent",
        "parentId": "root",
        "index": 1,
        "component": {
          "id": "title1",
          "type": "Title",
          "props": {}
        }
      }
    ]
  },
  "expected": {
    "submittedOps": 1,
    "normalizedOps": 0,
    "riskLevel": "low",
    "schemaValid": true
